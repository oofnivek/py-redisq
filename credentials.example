# redisq credentials — copy to ~/.redisq/credentials and fill in real values.
# Each [section] is a profile, selected with `redisq --profile <name>`.
# Inline comments must start with ";" (a "#" after a value is kept as part of the value).

[local]
host = 127.0.0.1
port = 6379

[uat]
host = uat-cache.example.cache.amazonaws.com
port = 6379                     ; optional, defaults to 6379
user = reader                   ; optional ACL user (Redis 6+); needs a password
password = change-me            ; optional; omit for a server without auth
db = 0                          ; optional database number, defaults to 0
tls = true                      ; optional; connect over TLS
; tls_ca = /path/to/ca.pem      ; optional CA bundle for TLS; defaults to the system store
socks_proxy = 127.0.0.1:1081    ; optional SOCKS5 proxy (no auth)
allow_write = false             ; optional; set to true to allow SET/DEL/FLUSHDB/...
